<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy (ARR + URL Rewrite) untuk spmi.universitaspahlawan.ac.id
  Upstream: Next.js standalone (PM2, app "spmi") di 127.0.0.1:3002.
  Berkas ini disalin ke E:\www\spmi-prod\iis\web.config oleh scripts/deploy/setup-production.ps1.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Validasi HTTP-01 win-acme dilayani langsung oleh IIS (berkas statis). -->
        <rule name="acme-challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/.*" />
          <action type="None" />
        </rule>
        <rule name="proxy-https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^ON$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:3002/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
        <rule name="proxy-http" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3002/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
        </rule>
      </rules>
      <outboundRules>
        <!-- ARR menambahkan X-Powered-By setelah tahap customHeaders; kosongkan di respons. -->
        <rule name="strip-arr-powered-by">
          <match serverVariable="RESPONSE_X-Powered-By" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- Biarkan Next.js merender halaman 404/500 sendiri. -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- 20 MB: unggahan bukti maks. 10 MB + overhead multipart Server Action. -->
        <requestLimits maxAllowedContentLength="20971520" />
        <hiddenSegments>
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
