DATABASE_URL="mysql://root:root@localhost:3307/lpm_spmi"
# WAJIB di produksi: string acak minimal 32 karakter. Tanpa ini server menolak start di produksi.
# Buat dengan: openssl rand -base64 48
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
AUTH_COOKIE_NAME="lpm_session"

# ==========================================================================
# SSO UP (Universitas Pahlawan) — paket @alfaqosry/sso-client-next
# ==========================================================================
# CATATAN: Sejak adanya menu Pengaturan (khusus Superadmin), kredensial SSO
# sebaiknya diisi lewat UI Pengaturan → Integrasi SSO (tersimpan di database
# dan MENIMPA nilai di bawah). Variabel di bawah hanya dipakai sebagai fallback
# bila belum diatur di database (kompatibilitas deployment lama).
#
# Dapatkan Client ID & Client Secret dari Admin SSO UP, lalu daftarkan
# Redirect URI: http://localhost:3002/api/sso/callback
SSO_URL="https://sso-v2.universitaspahlawan.ac.id"
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""
SSO_REDIRECT_URI="http://localhost:3002/api/sso/callback"
SSO_SCOPE="*"
SSO_PROMPT="login"

# Sumber kebenaran pemberian peran Admin LPM saat login SSO (pisahkan koma).
# HANYA email di daftar ini yang otomatis menjadi Admin LPM.
SSO_ADMIN_EMAILS=""

# KEAMANAN: default (kosong/false) TIDAK mempercayai klaim `role` dari SSO.
# Setel "true" HANYA jika SSO Anda tepercaya mengirim role admin/lpm.
SSO_TRUST_ROLE=""
